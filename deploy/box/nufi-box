#!/bin/bash
# nufi-box — operate the box without knowing Docker. bash 3.2 compatible.
set -euo pipefail
SELF="$0"
if [ -L "$SELF" ]; then
  T="$(readlink "$SELF")"
  case "$T" in /*) SELF="$T" ;; *) SELF="$(dirname "$SELF")/$T" ;; esac
fi
HERE="$(cd "$(dirname "$SELF")" && pwd)"
ENVF="${NUFI_BOX_ENV:-$HERE/.env}"
DRY="${NUFI_BOX_DRY_RUN:-0}"
run() { if [ "$DRY" = 1 ]; then printf '  $ %s\n' "$*"; else "$@"; fi; }
# This machine's address on the LAN, the same way install-box.sh works it out.
this_ip() {
  if [ "$OS" = "Darwin" ]; then
    ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo 127.0.0.1
  else
    hostname -I 2>/dev/null | awk '{print $1}' | grep . || echo 127.0.0.1
  fi
}
# What the LAN currently believes $BOX_HOST is, asked over mDNS.
announced_ip() {
  if [ "$OS" = "Darwin" ]; then
    # $2 == "Add", not /Add/: the header row's "Address" column contains
    # "Add", so a regex match takes the header and reports the box as pointing
    # at the literal string "Address" -- a false alarm on a healthy box, which
    # is the way to get this check ignored.
    dns-sd -t 2 -G v4 "${BOX_HOST:-nufi.local}" 2>/dev/null \
      | awk '$2 == "Add" {print $6; exit}'
  else
    avahi-resolve -n4 "${BOX_HOST:-nufi.local}" 2>/dev/null | awk '{print $2; exit}'
  fi
}
die() { echo "$*" >&2; exit 2; }
[ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
# NUFI_BOX_FAKE_OS lets the tests plan the other OS's run, exactly as
# install-box.sh does; nothing but tests ever sets it.
OS="${NUFI_BOX_FAKE_OS:-$(uname -s)}"
COMPOSE="docker compose -f $HERE/docker-compose.yml"
[ "${NUFI_EMULATE_AMD64:-0}" = "1" ] && COMPOSE="$COMPOSE -f $HERE/docker-compose.emulate.yml"
[ "$OS" = "Linux" ] && COMPOSE="$COMPOSE -f $HERE/docker-compose.linux.yml --profile linux"
# The installer decides the GPU layer from has_nvidia and records the answer as
# NVIDIA_VISIBLE_DEVICES in .env. Day two has to read it back: without this,
# `nufi-box restart` on a GPU box re-created the ollama container from the
# base file alone -- no device reservation, no `gpu` profile -- and the box
# quietly went back to answering on the CPU with nothing in the logs to say so.
[ -n "${NVIDIA_VISIBLE_DEVICES:-}" ] && COMPOSE="$COMPOSE -f $HERE/docker-compose.gpu.yml --profile gpu"
# The mesh node is part of a mesh box's stack, exactly as install-box.sh:500
# assembles it. Without this line `nufi-box` knew about every layer except that
# one, so `logs tailscale` -- which lib/mesh.sh prints as the thing to look at
# when a join fails -- answered "no such service"; `status` did not show the
# node; and `down` left it registered and advertising a box whose front door
# had just been stopped. macOS gets no container: Docker Desktop's host network
# is the Linux VM's, so it could never give the Mac a mesh address, and a Mac
# box joins with the native app instead (see mesh_up_native).
[ "$OS" = "Linux" ] && [ -n "${MESH_SERVER_URL:-}" ] \
  && COMPOSE="$COMPOSE -f $HERE/docker-compose.mesh.yml --profile mesh"
# Works and its egress proxy are one profile, switched on by the installer's
# --with-works (NUFI_WORKS=1). Without this line a works box's `restart` would
# bring up everything but the two services the flag was for.
[ "${NUFI_WORKS:-0}" = "1" ] && COMPOSE="$COMPOSE --profile works"
# Same check the installer makes (install-box.sh): docker compose treats a
# missing -f as an empty override and starts a stack without whatever the
# site-local file was there to change -- a port map, a mount, a memory cap.
for f in ${NUFI_BOX_COMPOSE_EXTRA:-}; do
  [ -f "$f" ] || die "NUFI_BOX_COMPOSE_EXTRA: no such file: $f"
  COMPOSE="$COMPOSE -f $f"
done
usage() {
  cat <<EOF
nufi-box <verb>

  status              every service, the model loaded, disk, drives
  logs [service]      follow logs (all, or one service)
  drive add <name>    create a department drive: folder, share, team and agent
  ca-cert             print the path of the certificate laptops must trust
  announce            re-publish the box's name at the address it has now
  doctor              check the things that usually break, in plain words
  up | down | restart start, stop, or restart the whole box
  mesh up | status | down
                      join this box to the coordinator so it can be reached
                      from home, show where it is on the mesh, or leave
  invite NAME [--os windows|macos|linux] [--drives a,b]
                      write a one-file join for a new laptop, from home
  members             list the laptops currently joined to the mesh
  revoke NAME | --id ID
                      remove a laptop's access to the mesh (use --id when
                      NAME matches more than one node)
  flows install       put the department routines into Studio (safe to repeat)
  flows list          every flow in the box's Studio, with its id
  works install       register the Docker sandbox environment in Works (the installer does this; re-run after an upgrade)
  works status        check whether Works is fully registered
  schedule list       the routines that run on a clock or when a file lands,
                      and when each fires next
  user add EMAIL [--name "Full Name"]
                      give somebody an account on this box
  user list           everyone who can sign in
  backup [--to DIR] [--keep N]
                      dump the databases, the drives and the secrets
  backup --install-nightly [--at HH:MM] | --remove-nightly
  restore DIR [--yes]  put a backup back, over this box
  update [--ref REF] | update --rollback
                      fetch the newest box, back it up, re-run the installer
                      that already keeps every answer and secret, check it,
                      and roll back automatically if the check fails (not
                      signed yet — GitHub over TLS, no signed bundle; see
                      README "What is not built yet")
  support              (coming — see README "What is not built yet")
EOF
}
case "${1:-}" in
  -h|--help|"") ;;
  *) [ -f "$ENVF" ] || { echo "no .env next to nufi-box — run install-box.sh first" >&2; exit 2; } ;;
esac
case "${1:-}" in
  status)
    run $COMPOSE ps --format 'table {{.Name}}\t{{.Status}}'
    echo; echo "Model: ${NUFI_MODEL:-?} via ${INFERENCE_PROFILE:-?}   Drives: ${NUFI_DATA_DIR:-?}/drives   Host: https://${BOX_HOST:-?}:3080"
    run df -h "${NUFI_DATA_DIR:-.}"
    # A backup nobody checks is a backup nobody has. The status line is where
    # somebody will see that the last one was three weeks ago.
    . "$HERE/lib/backup.sh"
    _last="$(backup_last)"
    if [ -n "$_last" ]; then echo "Last backup: $_last UTC"
    else echo "Last backup: never — run 'nufi-box backup'"; fi
    # Read, not computed: the file is update_run's own record of what it did
    # and when, and re-deriving either from the tree would just be a second
    # place for the two to disagree.
    if [ -f "$HERE/.previous/updated-from" ]; then
      read -r _upd_sha _upd_date < "$HERE/.previous/updated-from"
      echo "update: $_upd_sha since $_upd_date"
    else
      echo "update: never updated"
    fi ;;
  logs) shift; run $COMPOSE logs -f --tail=200 "$@" ;;
  announce)
    # Re-publish $BOX_HOST at the address this machine has now. One command,
    # because the common case is "the laptop moved network" and re-running the
    # whole installer for that is a hammer nobody reaches for before a demo.
    _now="$(this_ip)"
    echo "Announcing ${BOX_HOST:-nufi.local} at $_now"
    case "$OS" in
      Darwin)
        # The stale publisher first: dns-sd does not take a name another
        # process is still holding, so announcing over the top does nothing at
        # all and says so to nobody.
        run pkill -f "dns-sd -P ${BOX_NAME:-nufi} " || true
        run sh -c "nohup dns-sd -P ${BOX_NAME:-nufi} _https._tcp local 3080 ${BOX_HOST:-nufi.local} $_now >/dev/null 2>&1 &" ;;
      Linux)
        run pkill -f "avahi-publish -a -R ${BOX_HOST:-nufi.local}" || true
        run sh -c "nohup avahi-publish -a -R ${BOX_HOST:-nufi.local} $_now >/dev/null 2>&1 &" ;;
      *) die "no mDNS announcement for $OS" ;;
    esac
    # .env carries BOX_IP into the certificate and the banner, so it has to
    # follow the machine too -- otherwise the next `up` serves a certificate
    # for an address the box no longer has.
    . "$HERE/lib/envfile.sh"
    run envfile_set "$ENVF" BOX_IP "$_now"
    echo "BOX_IP=$_now"
    echo "Done. Check it with: nufi-box doctor" ;;
  drive)
    if [ "${2:-}" != "add" ]; then usage; exit 2; fi
    if [ -z "${3:-}" ]; then echo "drive add: a name is required" >&2; usage; exit 2; fi
    name="$3"
    case "$name" in *[!a-z0-9_-]*) echo "use lowercase letters, digits, - or _" >&2; exit 2 ;; esac
    [ -n "${NUFI_DATA_DIR:-}" ] || { echo "NUFI_DATA_DIR is not set in .env" >&2; exit 2; }
    key="$(printf '%s' "$name" | tr -c 'a-z0-9_\n' '_')"
    run mkdir -p "$NUFI_DATA_DIR/drives/$name"
    # Same rule the installer applies: a drive has to belong to the uid the
    # Samba account runs as, or a member's write to it comes back
    # NT_STATUS_ACCESS_DENIED. Usually a no-op — the admin adding a department
    # is the admin who installed the box — but `sudo nufi-box drive add` is an
    # easy reflex, and that one leaves a drive nobody can write to.
    if [ -n "${NUFI_SMB_UID:-}" ]; then
      _smb_gid="${NUFI_SMB_GID:-$NUFI_SMB_UID}"
      run chown -R "$NUFI_SMB_UID:$_smb_gid" "$NUFI_DATA_DIR/drives/$name" \
        || echo "could not give $NUFI_DATA_DIR/drives/$name to uid $NUFI_SMB_UID; members will not be able to write to it — run: sudo chown -R $NUFI_SMB_UID:$_smb_gid $NUFI_DATA_DIR/drives/$name" >&2
    fi
    case ",${DEPARTMENTS:-}," in
      *",$name,"*) new_depts="${DEPARTMENTS:-}" ;;
      *) new_depts="${DEPARTMENTS:+$DEPARTMENTS,}$name" ;;
    esac
    samba_line="\"[${name}]; path=/shares/${name}; valid users = nufi; guest ok = no; read only = no; browseable = yes\""
    if [ "$DRY" = 1 ]; then
      echo "DEPARTMENTS=$new_depts"
      printf 'SAMBA_VOLUME_CONFIG_%s=%s\n' "$key" "$samba_line"
    else
      . "$HERE/lib/envfile.sh"
      envfile_set "$ENVF" DEPARTMENTS "$new_depts"
      envfile_has "$ENVF" "SAMBA_VOLUME_CONFIG_$key" || envfile_set "$ENVF" "SAMBA_VOLUME_CONFIG_$key" "$samba_line"
    fi
    [ "$OS" = "Darwin" ] && run sudo sharing -a "$NUFI_DATA_DIR/drives/$name" -S "$name" -s 001
    [ "$OS" = "Linux" ] && run $COMPOSE up -d samba
    echo "The ingest daemon creates the '$name' team and agent on its next scan (about 20 s)." ;;
  ca-cert) echo "${NUFI_DATA_DIR:-$HERE/data}/nufi-box-ca.crt"; echo "Laptops: http://${BOX_HOST:-nufi.local}/" ;;
  doctor)
    fail=0
    chk() {
      if [ "$DRY" = 1 ]; then printf '  $ %s\n' "$*"; return 0; fi
      if "$@" >/dev/null 2>&1; then echo " ok  $*"; else echo " !!  $*"; fail=1; fi
    }
    chk docker info
    chk curl -fsk "https://localhost:3080/health"
    chk curl -fsk "https://localhost:3001/_health"
    chk curl -fsk "https://localhost:3001/.well-known/jwks.json"
    chk curl -fsk "https://localhost:3002/"
    chk curl -fsk "https://localhost:7860/health_check"
    chk curl -fsk "https://localhost:4000/health/liveliness"
    # From inside the box, not from this shell: OLLAMA_BASE_URL is written for
    # containers, and host.docker.internal is a name only they have.
    chk $COMPOSE exec -T rag_api python -c \
      "import os,urllib.request;urllib.request.urlopen(os.environ['OLLAMA_BASE_URL'].rstrip('/')+'/api/tags').read()"
    chk test -d "${NUFI_DATA_DIR:-$HERE/data}/drives"
    # Not a curl: a caddy/mesh.caddy written by an older box only bites at the
    # next Caddy restart, so a box can be answering perfectly right now and be
    # one reboot away from six dead ports. Say it in words while it is cheap.
    . "$HERE/lib/mesh.sh"
    if [ "$DRY" = 1 ]; then
      printf '  $ check %s against %s\n' "$HERE/caddy/mesh.caddy" "$HERE/Caddyfile"
    elif mesh_caddy_stale "$HERE/caddy/mesh.caddy" "$HERE/Caddyfile"; then
      echo " !!  caddy/mesh.caddy was written by an older box — run: nufi-box mesh up"; fail=1
    else
      echo " ok  caddy/mesh.caddy matches this Caddyfile"
    fi
    # The name every other laptop uses. Every check above this line goes to
    # localhost, which is exactly the address nobody else types -- so a box
    # whose mDNS announcement has gone stale passed all of them while being
    # unreachable from the rest of the room. The installer publishes
    # $BOX_HOST with the address the machine had that day, and a new DHCP
    # lease leaves the name pointing at a stranger. That happened three times
    # in five days on the box this was written on.
    if [ "$DRY" = 1 ]; then
      printf '  $ check %s resolves to this machine\n' "${BOX_HOST:-nufi.local}"
    else
      _now="$(this_ip)"; _said="$(announced_ip)"
      if [ -z "$_said" ]; then
        echo " !!  ${BOX_HOST:-nufi.local} is not being announced on the LAN — run: nufi-box announce"; fail=1
      elif [ "$_said" != "$_now" ]; then
        echo " !!  ${BOX_HOST:-nufi.local} points at $_said, this machine is $_now — run: nufi-box announce"; fail=1
      else
        echo " ok  ${BOX_HOST:-nufi.local} resolves to $_now"
      fi
    fi
    # A config that lost its Filter directive proxies everything and looks
    # healthy by any liveness probe. The one answer that proves the filter is
    # loaded is a refusal, so ask for a host that is on no list and expect the
    # 403. Asked from inside the sandbox network, which is the only place a
    # sandbox ever stands, using the proxy's own image so nothing new is
    # pulled. A box whose compose does not define the service skips this; a
    # box whose proxy is down fails it.
    # Captured before grep -q: under pipefail, grep closing the pipe on its
    # match makes compose's exit the pipeline's, and the check is skipped.
    if [ "$DRY" = 1 ]; then
      printf '  $ ask works-egress for a host not on the list, expect 403 (refuses)\n'
    elif _svcs=$($COMPOSE config --services 2>/dev/null) && printf '%s\n' "$_svcs" | grep -qx works-egress; then
      # Guarded: the script runs under set -e, and a missing network or image must be a "!!" line, not a doctor that stops mid-run.
      _img=$($COMPOSE config --images 2>/dev/null | grep nufi-works-egress | head -1) || _img=""
      _code=$(docker run --rm --network works-sandbox --entrypoint sh "$_img" -c \
        'http_proxy=http://works-egress:3128 wget -S -T 5 -O /dev/null http://healthcheck.invalid/ 2>&1 | sed -n "s/^ *HTTP\/[0-9.]* \([0-9]*\).*/\1/p" | head -1' 2>/dev/null) || _code=""
      if [ "$_code" = "403" ]; then echo " ok  works-egress refuses a host not on the list (403)"
      else echo " !!  works-egress answered ${_code:-nothing} for a host not on the list; the filter may not be loaded — run: nufi-box logs works-egress"; fail=1; fi
    fi
    # A Works box, four ways: the kernel boundary is a runtime the daemon
    # lists (a box whose daemon.json lost the stanza silently runs sandboxes
    # under runc); the works container can actually reach the socket (its gid
    # in .env matches the socket's, or the server is healthy while every
    # sandbox creation fails EACCES with nothing else to say so); the server
    # answers; and the registration holds -- provider ready, the Docker
    # environment the instance default, Local archived. Each can fail on its
    # own, and the fourth is asked of Works itself rather than inferred from
    # .env.
    if [ "${NUFI_WORKS:-0}" = 1 ]; then
      # Captured, then matched: under pipefail a `| grep -q` gate reports
      # grep's status, which is how the egress check above once skipped on
      # half its runs.
      _rt="$(docker info --format '{{range $k,$v := .Runtimes}}{{$k}} {{end}}' 2>/dev/null || true)"
      if [ "$DRY" = 1 ]; then
        printf '  $ docker info: runsc among the runtimes\n'
      elif case " $_rt " in *" runsc "*) true ;; *) false ;; esac; then
        echo " ok  runsc is a Docker runtime"
      else
        echo " !!  runsc is not a Docker runtime — sandboxes would run on the host kernel; run: install-box.sh --with-works"; fail=1
      fi
      if [ "$DRY" = 1 ]; then
        printf '  $ stat -c %%g /var/run/docker.sock == DOCKER_GID in .env\n'
      elif [ -n "${DOCKER_GID:-}" ] && [ "$(stat -c %g /var/run/docker.sock 2>/dev/null)" = "$DOCKER_GID" ]; then
        echo " ok  DOCKER_GID=${DOCKER_GID} is the socket's group"
      else
        echo " !!  DOCKER_GID in .env is '${DOCKER_GID:-}' but the socket's group is $(stat -c %g /var/run/docker.sock 2>/dev/null) — sandboxes cannot be created; run: install-box.sh --with-works"; fail=1
      fi
      chk curl -fsk "https://localhost:3003/api/health"
      . "$HERE/lib/works.sh"
      if [ "$DRY" = 1 ]; then
        works_check
      elif _wc="$(works_check 2>&1)"; then
        echo " ok  Works is registered: provider ready, Docker environment is the default, Local archived"
      else
        echo " !!  Works is not registered as installed — run: nufi-box works install"; fail=1
        printf '%s\n' "$_wc" | sed -n 's/^works: missing: /     - /p'
      fi
    fi
    [ "$fail" = 0 ] && echo "All good." || { echo "Something is off; run: nufi-box logs <service>"; exit 1; } ;;
  # Both start Caddy again, so both are places a caddy/mesh.caddy left behind by
  # an older box would refuse the whole front door. Put it back in step first.
  up) . "$HERE/lib/mesh.sh"; mesh_caddy_refresh "$HERE"; run $COMPOSE up -d ;;
  down) run $COMPOSE down ;;
  restart) . "$HERE/lib/mesh.sh"; mesh_caddy_refresh "$HERE"; run $COMPOSE restart ;;
  # --- the mesh ---
  mesh)
    shift
    case "${1:-}" in
      up|status|down) MESH_VERB="$1" ;;
      "") echo "mesh: say what to do — up, status or down" >&2; usage; exit 2 ;;
      *) echo "mesh: unknown subcommand: $1 (use up, status or down)" >&2; exit 2 ;;
    esac
    . "$HERE/lib/mesh.sh"
    "mesh_$MESH_VERB" ;;
  invite)
    shift
    [ -n "${1:-}" ] || { echo "invite: a name is required" >&2; usage; exit 2; }
    MESH_NAME="$1"; shift
    MESH_OS="macos"; MESH_DRIVES="${DEPARTMENTS:-}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --os) MESH_OS="${2:-}"; shift 2 ;;
        --drives) MESH_DRIVES="${2:-}"; shift 2 ;;
        *) echo "invite: unknown option: $1" >&2; exit 2 ;;
      esac
    done
    case "$MESH_OS" in
      windows|macos|linux) ;;
      *) echo "invite: --os must be windows, macos, or linux" >&2; exit 2 ;;
    esac
    case "$MESH_NAME" in
      *[!A-Za-z0-9_-]*) echo "invite: use letters, digits, - or _ for the name" >&2; exit 2 ;;
    esac
    [ -n "${BOX_MESH_HOST:-}" ] || { echo "invite: BOX_MESH_HOST is not set — run nufi-box mesh up first" >&2; exit 2; }
    . "$HERE/lib/mesh.sh"
    mesh_invite "$MESH_NAME" "$MESH_OS" "$MESH_DRIVES" ;;
  members)
    . "$HERE/lib/mesh.sh"
    mesh_nodes ;;
  revoke)
    shift
    . "$HERE/lib/mesh.sh"
    if [ "${1:-}" = "--id" ]; then
      [ -n "${2:-}" ] || { echo "revoke: --id requires a value" >&2; exit 2; }
      mesh_delete_by_id "$2"
    else
      [ -n "${1:-}" ] || { echo "revoke: a name is required (or --id ID)" >&2; usage; exit 2; }
      mesh_delete "$1"
    fi ;;
  # --- end the mesh ---
  # --- the department routines in Studio ---
  flows)
    shift
    case "${1:-}" in
      install|list) FLOWS_VERB="$1" ;;
      "") echo "flows: say what to do — install or list" >&2; usage; exit 2 ;;
      *) echo "flows: unknown subcommand: $1 (use install or list)" >&2; exit 2 ;;
    esac
    . "$HERE/lib/flows.sh"
    "flows_$FLOWS_VERB" ;;
  # --- NUFI Works on the box ---
  works)
    shift
    case "${1:-}" in
      install|status) WORKS_VERB="$1" ;;
      "") echo "works: say what to do — install or status" >&2; usage; exit 2 ;;
      *) echo "works: unknown subcommand: $1 (use install or status)" >&2; exit 2 ;;
    esac
    . "$HERE/lib/works.sh"
    "works_$WORKS_VERB" ;;
  user)
    # People, as opposed to laptops. `invite` and `members` are about machines
    # joining the mesh; this is about who may sign in at all.
    #
    # Registration is off on a box by design -- a department appliance is not a
    # public sign-up page -- so without this there was no way to give the second
    # person an account. The app image has carried the tools all along; nothing
    # surfaced them, and nothing wrote them down.
    shift
    case "${1:-}" in
      add)
        _email="${2:-}"
        [ -n "$_email" ] || die "user add: say who — nufi-box user add <email>"
        case "$_email" in
          *@*.*) : ;;
          *) die "user add: that is not an email address: $_email" ;;
        esac
        shift 2
        _name=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --name) _name="${2:?--name needs a value}"; shift 2 ;;
            *) die "user add: unknown option: $1" ;;
          esac
        done
        # The username the app wants, from the address an administrator has to
        # hand. The local part, minus anything the app would not take.
        _user="$(printf '%s' "${_email%%@*}" | tr -cd 'a-zA-Z0-9._-')"
        [ -n "$_name" ] || _name="$_user"
        # Generated, not asked for: the installer generates the admin password
        # the same way, and an administrator inventing one per person is how
        # every account on a box ends up sharing it.
        _pw="$(openssl rand -hex 8)"
        echo "Creating $_email on this box"
        run $COMPOSE exec -T librechat npm run create-user -- \
          "$_email" "$_name" "$_user" "$_pw"
        echo
        echo "  email:    $_email"
        echo "  password: $_pw"
        echo
        echo "Write it down now — it is not stored anywhere you can read it back."
        echo "They can change it once signed in." ;;
      list)
        run $COMPOSE exec -T librechat npm run list-users ;;
      "") echo "user: say what to do — add or list" >&2; usage; exit 2 ;;
      *) echo "user: unknown subcommand: $1 (use add or list)" >&2; exit 2 ;;
    esac ;;
  schedule)
    shift
    case "${1:-}" in
      list) : ;;
      "") echo "schedule: say what to do — list" >&2; usage; exit 2 ;;
      *) echo "schedule: unknown subcommand: $1 (use list)" >&2; exit 2 ;;
    esac
    . "$HERE/lib/schedule.sh"
    schedule_list ;;
  # --- end the department routines ---
  backup)
    shift
    BACKUP_TO=""; BACKUP_KEEP=""; NIGHTLY=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to) BACKUP_TO="${2:?--to needs a directory}"; shift 2 ;;
        --keep) BACKUP_KEEP="${2:?--keep needs a number}"; shift 2 ;;
        --at) BACKUP_AT="${2:?--at needs HH:MM}"; shift 2 ;;
        --install-nightly) NIGHTLY=install; shift ;;
        --remove-nightly) NIGHTLY=remove; shift ;;
        *) die "backup: unknown option: $1" ;;
      esac
    done
    export BACKUP_TO BACKUP_KEEP BACKUP_AT
    . "$HERE/lib/backup.sh"
    case "$NIGHTLY" in
      install) backup_install_nightly ;;
      remove) backup_remove_nightly ;;
      *) backup_run ;;
    esac ;;
  restore)
    shift
    BACKUP_YES=0
    _from=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --yes|-y) BACKUP_YES=1; shift ;;
        -*) die "restore: unknown option: $1" ;;
        *) _from="$1"; shift ;;
      esac
    done
    [ -n "$_from" ] || die "restore: say which backup — nufi-box restore <directory>"
    export BACKUP_YES
    . "$HERE/lib/backup.sh"
    backup_restore "$_from" ;;
  update)
    shift
    UPDATE_REF=""; UPDATE_YES=0; UPDATE_ROLLBACK=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --ref) UPDATE_REF="${2:?--ref needs a value}"; shift 2 ;;
        --rollback) UPDATE_ROLLBACK=1; shift ;;
        --yes) UPDATE_YES=1; shift ;;
        *) die "update: unknown option: $1" ;;
      esac
    done
    . "$HERE/lib/update.sh"
    if [ "$UPDATE_ROLLBACK" = 1 ]; then update_rollback
    else update_run "$UPDATE_REF" "$UPDATE_YES"; fi ;;
  support) echo "support: coming in the next phase (see README \"What is not built yet\")"; exit 3 ;;
  -h|--help|"") usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 2 ;;
esac
