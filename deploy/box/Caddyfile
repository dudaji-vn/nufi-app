{
	# Internal CA: laptops trust /data/caddy/pki/authorities/local/root.crt once.
	local_certs
	skip_install_trust
	# Every product sits on its own high port, so nothing here belongs on 443.
	# Left on, Caddy's automatic redirect claims http://<box>/ for the hostname
	# and sends it to https://<box>:3001 — which is exactly the URL a laptop
	# opens to fetch the CA it does not trust yet.
	auto_https disable_redirects
	# A browser opened at https://<BOX_IP>:3080 sends no SNI — SNI carries names,
	# not addresses — and Docker's NAT hides the LAN address from Caddy too, so
	# without this Caddy has nothing to pick a certificate by and aborts the
	# handshake. Naming the IP as the default SNI makes the no-SNI case serve
	# the certificate whose SAN is that IP, which is what such a browser wants.
	default_sni {$BOX_IP}
}

(box_tls) {
	tls internal
}

# Plain HTTP landing page: links, the root certificate, per-OS trust steps.
# No host matcher and every interface, so this one site also answers on the
# box's mesh name and mesh address once it has joined — which is why
# caddy/mesh.caddy carries the five TLS ports and nothing for :80.
:80 {
	root * /srv/landing
	file_server
	handle /healthz {
		respond "ok" 200
	}
	handle /nufi-box-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
		header Content-Type "application/x-x509-ca-cert"
	}
}

# The NuFi app
{$BOX_HOST}:3080, {$BOX_IP}:3080, localhost:3080 {
	import box_tls
	reverse_proxy librechat:3080
}

# The console (identity authority; /choose is the products page)
{$BOX_HOST}:3001, {$BOX_IP}:3001, localhost:3001 {
	import box_tls
	reverse_proxy console:3000
}

# The admin panel
{$BOX_HOST}:3002, {$BOX_IP}:3002, localhost:3002 {
	import box_tls
	reverse_proxy admin-panel:3000
}

# NUFI Studio. /nufi/* is the console, so Studio's session-expiry bounce
# (VITE_NUFI_ENTER_URL=/nufi/enter/studio in the box image) lands on the console
# while staying on the Studio origin.
(studio_routes) {
	import box_tls
	handle_path /nufi/* {
		reverse_proxy console:3000
	}
	handle {
		reverse_proxy studio:7860
	}
}

{$BOX_HOST}:7860, {$BOX_IP}:7860, localhost:7860 {
	import studio_routes
}

# The gateway, for API keys issued by the console
{$BOX_HOST}:4000, {$BOX_IP}:4000, localhost:4000 {
	import box_tls
	reverse_proxy litellm-proxy:4000
}

# The same five TLS sites again on the box's mesh address and MagicDNS name, once
# it has joined a coordinator. `nufi-box mesh up` generates caddy/mesh.caddy
# with the literal addresses and reloads Caddy; `mesh down` empties it again.
#
# A glob, not the bare path: Caddy treats a missing literal import as a fatal
# config error ("File to import not found") and the entire front door then
# refuses to start, while a glob matching nothing is only a warning. A box
# that never joined a mesh has no caddy/mesh.caddy at all.
import caddy/mesh*.caddy
