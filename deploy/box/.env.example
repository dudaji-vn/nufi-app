# =============================================================================
# NuFi box — environment template. install-box.sh writes .env from this file;
# never commit .env. Values ending in replace-me are generated on the box.
# =============================================================================

# --- Identity of this box ------------------------------------------------
BOX_NAME=nufi                     # short name; the LAN hostname is ${BOX_NAME}.local
BOX_HOST=nufi.local               # hostname laptops use; also a TLS SAN and a compose alias
BOX_IP=192.168.1.10               # LAN IP at install time; a TLS SAN so https://<ip>:3080 works
NUFI_DATA_DIR=./data              # host dir for drives/<dept>, backups, and the CA copy

# --- Image registry (install-box.sh --registry sets this) ----------------
# a private/LAN registry for boxes without GitHub access; the VM test uses
#   the Mac's `registry:2`. Every NuFi image is pulled as
#   ${NUFI_REGISTRY}/<name>:<tag> — leave it as ghcr.io/dudaji-vn to pull
#   the public images.
NUFI_REGISTRY=ghcr.io/dudaji-vn

# --- Image tags (the release pins these) ---------------------------------
NUFI_CHAT_TAG=main
NUFI_CONSOLE_TAG=main
NUFI_ADMIN_TAG=main
NUFI_STUDIO_TAG=box-main
NUFI_LITELLM_TAG=main
NUFI_INGEST_TAG=main
# 1 on an Apple Silicon box whose amd64-only images run under emulation
# (install-box.sh --emulate-amd64); layers docker-compose.emulate.yml.
NUFI_EMULATE_AMD64=0
# rag_api upstream only publishes :latest; pin by digest so a box is reproducible.
NUFI_RAG_IMAGE=ghcr.io/danny-avila/librechat-rag-api-dev-lite@sha256:f9f34c8ed6884b0ff9b17387e6174fed737dba29f21622ecb75604d82bc47bf8
# Samba is on ghcr.io too; a box without GitHub access mirrors it (see README)
NUFI_SAMBA_IMAGE=ghcr.io/servercontainers/samba:a3.24.1-s4.23.8-r0

# --- Inference profile ---------------------------------------------------
# ollama         Ollama on the host (macOS default, Linux with Ollama installed)
# ollama-docker  Ollama container from docker-compose.linux.yml (Linux default)
# remote         any OpenAI-compatible server on the LAN (vLLM, RNGD, TGI)
# cloud          an API provider; the box is no longer air-gapped
INFERENCE_PROFILE=ollama
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_API_KEY=ollama
INFERENCE_MODEL=qwen2.5:7b        # what the backend calls the model
NUFI_MODEL=qwen2.5-7b             # what the app and agents call it (litellm alias)
EMBEDDINGS_MODEL=bge-m3           # pulled into Ollama by the installer
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Linux profile: ollama container (docker-compose.linux.yml / docker-compose.gpu.yml) ---
NVIDIA_VISIBLE_DEVICES=           # installer sets to "all" when nvidia-smi is present; empty = CPU

# --- People --------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
INGEST_EMAIL=admin@example.com    # who the ingest daemon runs as; defaults to ADMIN_EMAIL,
INGEST_PASSWORD=replace-me        #   so the admin owns every department team and agent and
                                  #   can invite colleagues from the app's Teams UI.
                                  #   Set BOTH to run it as a separate service account —
                                  #   then nobody but that account sees the agents until
                                  #   it invites them.
DEPARTMENTS=legal,hr,ga,strategy  # one drive, one team, one agent each

# --- Secrets — generated by the installer --------------------------------
JWT_SECRET=replace-me             # openssl rand -hex 32
JWT_REFRESH_SECRET=replace-me     # openssl rand -hex 32
CREDS_KEY=replace-me              # openssl rand -hex 32
CREDS_IV=replace-me               # openssl rand -hex 16
LITELLM_MASTER_KEY=sk-replace-me  # openssl rand -hex 32
LITELLM_SALT_KEY=replace-me       # openssl rand -hex 32
POSTGRES_PASSWORD=replace-me      # openssl rand -hex 16
MONGO_PASSWORD=replace-me         # openssl rand -hex 16
OIDC_PRIVATE_KEY_PEM="replace-me" # RS256 PEM with \n escapes; console signs Studio identities
LANGFLOW_SECRET_KEY=replace-me    # Fernet: openssl rand -base64 32 | tr '+/' '-_'
STUDIO_SUPERUSER_PASSWORD=replace-me
ADMIN_SESSION_SECRET=replace-me   # admin panel; >= 32 chars
SAMBA_PASSWORD=replace-me         # Linux drives; macOS uses File Sharing

# --- The mesh: reaching this box from home -------------------------------
# Set by install-box.sh --mesh URL --auth-key KEY [--mesh-api-key KEY], or by
# hand. Empty = a LAN-only box, which is the default; nothing mesh-related
# starts and the Caddyfile imports an empty caddy/mesh.caddy.
MESH_SERVER_URL=                  # the coordinator, e.g. https://mesh.nufi.me
MESH_AUTH_KEY=                    # single-use pre-auth key (tag:box) for THIS box
MESH_API_KEY=                     # headscale API key; what `nufi-box invite`
                                  #   and `members`/`revoke` authenticate with
# The coordinator's CA, when it is not a public one (the Docker lab, a dev
# coordinator on TLS_MODE=internal). Mounted into the tailscale container as
# SSL_CERT_FILE; the default is the host's own bundle, i.e. no change.
MESH_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# --- Written by `nufi-box mesh up`; do not set these by hand --------------
BOX_MESH_IP=                      # 100.64.x.y, this box's address on the mesh
BOX_MESH_HOST=                    # MagicDNS name, e.g. nufi.box.nufi.me
