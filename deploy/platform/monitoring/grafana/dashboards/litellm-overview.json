      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Real per-control decisions from nufi_guardrail_decisions_total. Replaces a 4xx-rate heuristic that predated the guardrail metrics and reads zero forever in shadow mode, where a correct control records a decision and deliberately does NOT change the response.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "blocks/s",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "reqps"
        }
