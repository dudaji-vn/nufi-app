      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "expr": "sum by (control, action) (rate(nufi_guardrail_decisions_total[5m]))",
          "legendFormat": "{{control}} {{action}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "title": "Guardrail decisions by control",
      "type": "timeseries"
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Controls enforcing",
      "description": "nufi_guardrail_enabled is 1 only when a control is enabled AND enforcing. All five ship logging_only, so 0 is the expected value. NO DATA here means the guardrail module did not load at all -- a different failure from 0, and the one this project exists to catch.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(nufi_guardrail_enabled)",
          "legendFormat": "enforcing",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Guardrail degraded (failing open)",
      "description": "1 while a control fails open because its detector is unreachable. In shadow mode this means requests pass UNSCANNED and nothing else reports it.",
      "gridPos": {
        "x": 24,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
