        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Guardrail latency p95 by control",
      "description": "Times the detector call only -- extract_spans, canonicalize, decide and the audit write sit outside the timer (design 13.2). Treat as a floor, not the control's full cost.",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 48,
        "h": 7
      },
