# =============================================================================
# NPUOps Platform — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# LiteLLM Proxy
# -----------------------------------------------------------------------------
# Master admin key for the LiteLLM proxy. Used to mint virtual keys and
# authenticate admin API calls. Generate with: `openssl rand -hex 32`
LITELLM_MASTER_KEY=sk-replace-me

# Salt used to hash virtual keys at rest in the LiteLLM key store.
# Generate with: `openssl rand -hex 32`
LITELLM_SALT_KEY=replace-me

# -----------------------------------------------------------------------------
# PostgreSQL (shared by LiteLLM key store + Langfuse)
# -----------------------------------------------------------------------------
POSTGRES_USER=npuops
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=npuops
# Connection string consumed by LiteLLM (`general_settings.database_url`)
DATABASE_URL=postgresql://npuops:replace-me@postgres:5432/npuops

# -----------------------------------------------------------------------------
# Redis (rate limiting + cache)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Langfuse (observability / cost tracking) — v3 stack
# -----------------------------------------------------------------------------
# Project credentials. On first boot Langfuse auto-provisions a project with
# these values via LANGFUSE_INIT_*; rotate later via the UI if you want.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Used by LiteLLM to ship traces. Inside the compose network: langfuse-web:3000
LANGFUSE_HOST=http://langfuse-web:3000

# NextAuth secret. Generate with: `openssl rand -base64 32`
LANGFUSE_NEXTAUTH_SECRET=replace-me
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# Salt for hashing user passwords. Generate with: `openssl rand -base64 32`
LANGFUSE_SALT=replace-me
# AES-256 key used to encrypt API keys at rest. MUST be 32 bytes hex (64 chars).
# Generate with: `openssl rand -hex 32`
LANGFUSE_ENCRYPTION_KEY=replace-me

# Initial admin user (created on first boot).
LANGFUSE_INIT_USER_EMAIL=admin@npuops.local
# Quote any value containing spaces so `source .env` from shell scripts works.
LANGFUSE_INIT_USER_NAME="NPUOps Admin"
LANGFUSE_INIT_USER_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# ClickHouse (Langfuse v3 trace store — required)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# MinIO (Langfuse v3 blob storage for events / multi-modal payloads)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# LibreChat (chat interface — Apache-2.0; replaced Open WebUI in W1)
# -----------------------------------------------------------------------------
APP_TITLE=NPUOps
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
# Auth signing keys. Generate with: `openssl rand -hex 32`
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
# Credential encryption (LibreChat encrypts user-provided API keys at rest).
# CREDS_KEY: 32 bytes hex (64 chars) — `openssl rand -hex 32`
# CREDS_IV:  16 bytes hex (32 chars) — `openssl rand -hex 16`
CREDS_KEY=replace-me
CREDS_IV=replace-me

# -----------------------------------------------------------------------------
# MongoDB (LibreChat app data)
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=librechat
MONGO_INITDB_ROOT_PASSWORD=replace-me
MONGO_URI=mongodb://librechat:replace-me@mongodb:27017/LibreChat?authSource=admin

# -----------------------------------------------------------------------------
# GPU backend (W1 — any OpenAI-compatible server: vLLM / TGI / Ollama / etc.)
# -----------------------------------------------------------------------------
# Upstream model name as the backend serves it. Must include the LiteLLM
# provider prefix (e.g. `openai/...`). Examples:
#   openai/qwen2.5:3b           # Ollama, local dev on Mac
#   openai/llama-3-8b           # vLLM serving llama-3-8b
GPU_MODEL=openai/qwen2.5:3b

# Local dev (host Ollama):
#   GPU_BACKEND_BASE_URL=http://host.docker.internal:11434/v1
#   GPU_BACKEND_API_KEY=ollama
GPU_BACKEND_BASE_URL=http://host.docker.internal:11434/v1
GPU_BACKEND_API_KEY=ollama
GPU_HARDWARE_ID=mac-local

# -----------------------------------------------------------------------------
# NPU backend (W8 — placeholder, leave empty until integration)
# -----------------------------------------------------------------------------
NPU_BACKEND_BASE_URL=
NPU_BACKEND_API_KEY=
NPU_HARDWARE_ID=

# -----------------------------------------------------------------------------
# Guardrails (W5 — LLM Guard / Lakera)
# -----------------------------------------------------------------------------
LAKERA_API_KEY=

# -----------------------------------------------------------------------------
# Monitoring (W5 — Grafana admin)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
