# =============================================================================
# NuFi coordinator — environment template. bootstrap.sh writes .env from this
# file the first time it runs; never commit .env.
# =============================================================================

# --- Identity of this coordinator ------------------------------------------
# The hostname members' Tailscale clients and the box connect to. A DNS A
# record for this name must point at the VPS before bootstrap.sh runs in
# TLS_MODE=acme (Let's Encrypt's HTTP-01 challenge resolves it).
MESH_SERVER_HOST=mesh.nufi.me

# The MagicDNS base domain: every mesh member gets <name>.${MESH_BASE_DOMAIN}.
# headscale requires this to differ from MESH_SERVER_HOST's domain — it must
# not be a suffix of it (bootstrap.sh checks this and refuses to start
# otherwise). lab: box.lab (with MESH_SERVER_HOST=coordinator.lab).
MESH_BASE_DOMAIN=box.nufi.me

# --- TLS ---------------------------------------------------------------------
# acme      Caddy requests a public certificate from Let's Encrypt for
#           MESH_SERVER_HOST (needs a real DNS record and inbound :80/:443).
# internal  Caddy's own internal CA; bootstrap.sh exports the root cert to
#           data/coordinator-ca.crt for the lab or a VM to trust. No public
#           DNS needed — used for the local Docker lab and dev.
TLS_MODE=acme
# Required when TLS_MODE=acme: the contact address Let's Encrypt is told for
# this certificate (expiry notices only; never shared with clients).
ACME_EMAIL=replace-me@example.com
