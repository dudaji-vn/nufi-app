# The coordinator's identity *inside the lab*. This file is the `env_file:` of
# the `include:` block in docker-compose.yml, so it — not the operator's shell
# and not deploy/coordinator/.env — is what interpolates ${MESH_SERVER_HOST}
# and friends in the included coordinator compose files. Committed on purpose:
# these are lab facts, not secrets.
#
# coordinator.lab  the name node-a/node-b dial for the control plane, DERP
#                  (TCP 443) and STUN (UDP 3478). Resolved by an `extra_hosts`
#                  entry on every lab container — 172.30.0.10 on the `wan`
#                  network. There is no DNS server in the lab.
# box.lab          the MagicDNS base domain, so the box stand-in (node-b,
#                  hostname `nufi`) is reachable as nufi.box.lab over the mesh.
#                  headscale requires this to differ from MESH_SERVER_HOST's
#                  domain, which `.lab` vs `coordinator.lab` satisfies.
MESH_SERVER_HOST=coordinator.lab
MESH_BASE_DOMAIN=box.lab
TLS_MODE=internal
ACME_EMAIL=
