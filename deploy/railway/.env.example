# =============================================================================
# nufi-chat — env template
# Copy to .env, fill in secrets, never commit .env.
# =============================================================================

# --- Public URL ----------------------------------------------------------
# Local test on the VM: http://<VM_IP>:3081
# Production-ish: https://chat.nufi.me (after Cloudflare Tunnel route is added)
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081
APP_TITLE=Nufi Chat

# --- Auth ----------------------------------------------------------------
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true

# --- Secrets — generate fresh, do NOT reuse npuops-platform values -------
# JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY: openssl rand -hex 32
# CREDS_IV:                                    openssl rand -hex 16
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# --- Codechi LiteLLM key -------------------------------------------------
# Copy LITELLM_MASTER_KEY from ~/npuops-platform/.env on the VM. Later, swap
# this for a virtual key created via the console (console.codechi.me) so
# dev traffic is budget-isolated from prod.
LITELLM_MASTER_KEY=
