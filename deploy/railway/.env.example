# =============================================================================
# nufi-chat — env template
# Copy to .env, fill in values, never commit .env.
# bootstrap.sh handles all of this interactively if you prefer.
# =============================================================================

# --- Image version -------------------------------------------------------
# Tag of ghcr.io/dudaji-vn/nufichat to run. Leave unset to fall back to the
# `main` floating tag, or pin a release (e.g. nufi-v0.0.5). The Console
# redirect entry requires >= nufi-v0.0.5.
# IMAGE_TAG=nufi-v0.0.5

# --- Public URL ----------------------------------------------------------
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081
APP_TITLE=Nufi Chat

# --- Auth ----------------------------------------------------------------
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true

# --- Cross-subdomain SSO (optional) --------------------------------------
# Set both ONLY if other apps on the same parent domain should share this
# stack's session cookies (e.g. console.nufi.me reading auth issued by
# chat.nufi.me). Leave empty for a single-host deployment.
#
#   COOKIE_DOMAIN=.nufi.me     # leading dot → all subdomains of nufi.me
#   COOKIE_SAMESITE=lax        # must NOT be 'strict' for cross-site reads
COOKIE_DOMAIN=
COOKIE_SAMESITE=strict

# --- Secrets — generate fresh per deploy ---------------------------------
# JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY: openssl rand -hex 32
# CREDS_IV:                                    openssl rand -hex 16
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# --- Backend LLM endpoint ------------------------------------------------
# Any OpenAI-compatible API works here: LiteLLM, vLLM, TGI, OpenAI itself,
# OpenRouter, Together, Groq, an Anthropic / Bedrock proxy, etc.
#
# Examples:
#   http://litellm-proxy:4000/v1    # Docker service name (requires shared network — see below)
#   http://192.168.1.10:4000/v1     # LAN IP
#   https://api.openai.com/v1       # OpenAI directly
#   https://openrouter.ai/api/v1    # OpenRouter
BACKEND_BASE_URL=

# Sent as `Authorization: Bearer <key>` to the URL above.
BACKEND_API_KEY=

# --- Console redirect (optional) -----------------------------------------
# Public URL of the NUFI Console. When set, an entry appears in the Account
# Settings dropdown that opens this URL. Leave empty to hide the entry.
#   CONSOLE_URL=https://console.nufi.me
CONSOLE_URL=

# --- RAG (file upload for end users) -------------------------------------
# Enables the document-upload RAG UI. The rag_api + vectordb services in
# docker-compose.yml embed uploaded files so the model can retrieve from them.
# This demo uses Google Gemini embeddings (AI Studio) — paste a Gemini key.
#   Get a key at https://aistudio.google.com/apikey
RAG_GOOGLE_API_KEY=
EMBEDDINGS_PROVIDER=google_genai
EMBEDDINGS_MODEL=gemini-embedding-001
# Internal port the rag_api listens on (rarely needs changing).
RAG_PORT=8000

# --- Shared Docker network (optional) ------------------------------------
# Only used when docker-compose.override.yml is symlinked to
# docker-compose.shared-network.yml. The named network must already exist.
# SHARED_DOCKER_NETWORK=npuops_npuops

# --- LiteLLM gateway sync (optional) -------------------------------------
# When enabled, every custom endpoint an admin creates in the admin panel is
# auto-registered in your central LiteLLM proxy and ALL its traffic is routed
# through it: per-endpoint virtual keys, provider keys hidden inside LiteLLM,
# centralized cost/logging/rate-limit. Fail-closed — a not-yet-synced endpoint
# is unusable rather than calling the provider directly.
#
# OFF by default: with LITELLM_SYNC_ENABLED=false nothing changes (endpoints
# call their providers directly, as before). Flip to true only after the image
# ships and you've set the two values below.
LITELLM_SYNC_ENABLED=false
# Base URL of your LiteLLM proxy (a trailing /v1 is normalized automatically).
LITELLM_BASE_URL=https://api.codechi.me
# LiteLLM master key (admin API). Sent as `Authorization: Bearer`. NEVER commit
# a real key. ROTATE the key that was shared during design before using it here.
LITELLM_MASTER_KEY=
