# =============================================================================
# nufi-chat — env template
# Copy to .env, fill in values, never commit .env.
# bootstrap.sh handles all of this interactively if you prefer.
# =============================================================================

# --- Public URL ----------------------------------------------------------
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081
APP_TITLE=Nufi Chat

# --- Auth ----------------------------------------------------------------
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true

# --- Secrets — generate fresh per deploy ---------------------------------
# JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY: openssl rand -hex 32
# CREDS_IV:                                    openssl rand -hex 16
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# --- Backend LLM endpoint ------------------------------------------------
# Any OpenAI-compatible API works here: LiteLLM, vLLM, TGI, OpenAI itself,
# OpenRouter, Together, Groq, an Anthropic / Bedrock proxy, etc.
#
# Examples:
#   http://litellm-proxy:4000/v1    # Docker service name (requires shared network — see below)
#   http://192.168.1.10:4000/v1     # LAN IP
#   https://api.openai.com/v1       # OpenAI directly
#   https://openrouter.ai/api/v1    # OpenRouter
BACKEND_BASE_URL=

# Sent as `Authorization: Bearer <key>` to the URL above.
BACKEND_API_KEY=

# --- Shared Docker network (optional) ------------------------------------
# Only used when docker-compose.override.yml is symlinked to
# docker-compose.shared-network.yml. The named network must already exist.
# SHARED_DOCKER_NETWORK=npuops_npuops
